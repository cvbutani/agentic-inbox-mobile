<?xml version="1.0" encoding="utf-8"?>
<!-- Cleartext is permitted to loopback only, where the profile generator's stub Worker listens.
     Everything else keeps the platform default (HTTPS only). -->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">127.0.0.1</domain>
    </domain-config>
</network-security-config>
